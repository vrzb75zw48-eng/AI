<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvAccessibilityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#FF5722"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnEnableAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开启无障碍服务"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="启动前台服务"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="联系人列表（长按移除）"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etNewContact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="抖音昵称"
                android:inputType="text"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnAddContact"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="＋"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <ListView
            android:id="@+id/lvContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="定时触发时间"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etScheduleHour"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="时(0-23)"
                android:inputType="number"
                android:maxLength="2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="20sp"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <EditText
                android:id="@+id/etScheduleMinute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="分(0-59)"
                android:inputType="number"
                android:maxLength="2" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送消息"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🔥 火花+1"
            android:maxLines="1"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnManualTrigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="立即执行一次"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnQuickSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="一键发送消息"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#FF6C00"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnDiscovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UI 转储工具"
            android:layout_marginBottom="0dp" />

    </LinearLayout>
</ScrollView>
