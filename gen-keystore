#!/usr/bin/env bash
# ============================================================
# 生成 Cocos Android release keystore + 打印 4 个 GitHub secrets 值
# 用途：把打印出的值配进 repo 的 Settings → Secrets and variables → Actions
# 需 JDK（keytool）在 PATH 上
# 用法：
#   ./gen-keystore [keystore路径] [alias]
#   可选：STORE_PASS=<密码> DN="CN=x,O=y,C=US" ./gen-keystore
# ============================================================
set -euo pipefail

KS="${1:-cocos-release.keystore}"
ALIAS="${2:-cocoskey}"
PASS="${STORE_PASS:-cocos1234}"
DN="${DN:-CN=ci,O=ci,C=US}"

command -v keytool >/dev/null || { echo "!! 缺 keytool（需 JDK：apt install default-jdk 或装 JDK 17）"; exit 1; }

# 非交互生成 keystore（keytool；-storepass/-keypass/-dname 免交互）
keytool -genkeypair -keystore "$KS" -alias "$ALIAS" \
  -keyalg RSA -keysize 2048 -validity 10000 \
  -storepass "$PASS" -keypass "$PASS" -dname "$DN"

# stdin 形式在 GNU / BSD 的 base64 上都可用（BSD 不接位置参数，GNU -w0 BSD 不认）
B64="$(base64 < "$KS" | tr -d '\n')"

echo "================= keystore 已生成：$KS ================="
echo "配 GitHub repo 的 4 个 Secrets（复制下面 4 行值）："
echo "  ANDROID_KEYSTORE            = ${B64:0:60}...(base64，长度 ${#B64}，完整值见下方第 2 行打印)"
echo "  ANDROID_KEYSTORE_PASSWORD   = ${PASS}"
echo "  ANDROID_KEY_ALIAS           = ${ALIAS}"
echo "  ANDROID_KEY_PASSWORD        = ${PASS}"
echo "---- 完整 base64（直接复制为 ANDROID_KEYSTORE 的值）----"
echo "$B64"
